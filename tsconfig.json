{
    "extends": "./tsconfig.base",
    "compilerOptions": {
        "lib": ["ES2017"],
        "strict": true,
        "paths": {
            "@/*": ["./src/*"],
            "@/assets/*": ["./assets/*"],
            "@/types/*": ["./src/types/*"]
        }
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        ".expo/types/**/*.ts",
        "expo-env.d.ts",
        "nativewind-env.d.ts"
    ],
    "exclude": ["node_modules"]
}
